# Configuración para publicar el sitio en Hostinger (Apache/LiteSpeed). Es el equivalente de vercel.json.
# Se copia como ".htaccess" a la carpeta public_html junto con el contenido de dist/ (npm run build:hostinger lo deja
# ya en dist/.htaccess). SIN PROBAR en Hostinger todavía: al publicar, comprobar lo que dice deploy/README.md.
#
# IMPORTANTE: reemplaza el .htaccess de WordPress si lo hay. Nunca subir el robots.txt de WordPress (bloquea a Google).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Siempre por HTTPS (se conserva el dominio con el que entró el visitante, así también funciona en la dirección temporal).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) cbsperu.com (sin www) -> www.cbsperu.com
  RewriteCond %{HTTP_HOST} ^cbsperu\.com$ [NC]
  RewriteRule ^ https://www.cbsperu.com%{REQUEST_URI} [L,R=301]

  # 3) /index.html -> /   y   /pagina.html -> /pagina   (una sola dirección por página)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
  RewriteCond %1 !=404
  RewriteRule ^ /%1 [L,R=301]

  # 4) Barra final fuera: /limp-city/ -> /limp-city
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 5) /limp-city se sirve desde limp-city.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Una dirección que no existe devuelve la página 404 con código 404.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"

  # Los archivos de /assets/ llevan el contenido en el nombre: se guardan un año. Las páginas se revalidan siempre.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/og/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
