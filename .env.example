# Copia este archivo a .env.local y completa los valores reales. .env.local
# está en gitignore (coincide con *.local) y nunca se debe subir al repo.

# Access key de Web3Forms (web3forms.com) -- asociada a la bandeja que recibe
# los envíos del formulario de contacto. Es pública por diseño de este
# servicio (Vite expone al navegador las variables con prefijo VITE_), no es
# un secreto tradicional.
VITE_WEB3FORMS_ACCESS_KEY=
