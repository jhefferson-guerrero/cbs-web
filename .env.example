# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (matches *.local) and must never be committed.

# Web3Forms access key (web3forms.com) -- tied to the inbox that receives
# contact-form submissions. Public-by-design for this service (Vite exposes
# VITE_-prefixed vars to the client bundle), not a traditional secret.
VITE_WEB3FORMS_ACCESS_KEY=
